{
  "openapi": "3.1.0",
  "info": {
    "title": "tbank-mock — Т-Банк EACQ / Мультирасчёты / СБП / Рекурренты / acqapi (Мок-стенд)",
    "version": "0.5.0",
    "description": "Полнофункциональный мок-стенд эквайринга и Мультирасчётов Т-Банка с поддержкой вебхуков, ретраев, чарджбэков, СБП QR, рекуррентов, регистрации партнёров acqapi, виртуальных часов и мульти-песочниц."
  },
  "servers": [
    { "url": "http://localhost:3100", "description": "Локальный стенд tbank-mock" }
  ],
  "components": {
    "securitySchemes": {
      "operatorToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Operator-Token",
        "description": "Токен управляющей поверхности (MOCK_OPERATOR_TOKEN; также Authorization: Bearer или ?operator_token=). Если токены не заданы, локальный стенд открыт; при MOCK_HOSTED=1 без секрета маршрут закрыт (fail-closed)."
      },
      "adminToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Admin-Token",
        "description": "Токен админки /admin* (MOCK_ADMIN_TOKEN)."
      },
      "sandboxToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Sandbox-Token",
        "description": "Owner-token песочницы (RFC-001): выдаётся один раз при POST /sandboxes; также Authorization: Bearer <ownerToken> или ?sandbox_token=. В режиме MOCK_TENANCY=on / MOCK_HOSTED=1 знание id песочницы без owner-token доступа не даёт."
      },
      "acqapiBasic": {
        "type": "http",
        "scheme": "basic",
        "description": "Basic client credentials acqapi: по умолчанию partner:partner; переопределяются MOCK_ACQAPI_CLIENT_ID и MOCK_ACQAPI_CLIENT_SECRET."
      },
      "acqapiBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "opaque",
        "description": "Bearer access_token из /oauth/token, scope partner, TTL по умолчанию 3600 секунд."
      }
    },
    "parameters": {
      "XMockScenario": {
        "name": "X-Mock-Scenario",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "Сценарий управления поведением: reject:<code>, 3ds, hold-confirm-after:<dur>, partial-refund:<N%>, chargeback-after:<dur>, webhook-drop, webhook-duplicate, latency:<dur>, http-500, http-504."
      },
      "XMockSandbox": {
        "name": "X-Mock-Sandbox",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "Имя изолированной песочницы для параллельных CI-воркеров (по умолчанию default)."
      },
      "XMockLatency": {
        "name": "X-Mock-Latency",
        "in": "header",
        "required": false,
        "schema": { "type": "string" },
        "description": "Искусственная задержка ответа (например, 500ms или 2s)."
      }
    },
    "schemas": {
      "SignedRequest": {
        "type": "object",
        "required": ["TerminalKey", "Token"],
        "properties": {
          "TerminalKey": { "type": "string", "example": "TBANKMOCKTEST" },
          "Token": { "type": "string", "description": "SHA-256 подпись скалярных полей верхнего уровня + Password" }
        }
      },
      "BankResponse": {
        "type": "object",
        "required": ["Success", "ErrorCode"],
        "properties": {
          "Success": { "type": "boolean" },
          "ErrorCode": { "type": "string" },
          "Message": { "type": "string" },
          "Details": { "type": "string" },
          "field": { "type": "string" },
          "hint": { "type": "string" },
          "doc": { "type": "string" }
        }
      },
      "AcqapiRegistration": {
        "type": "object",
        "required": ["shopArticleId", "billingDescriptor", "fullName", "name", "inn", "kpp", "ogrn", "addresses", "ceo", "founders", "email", "siteUrl", "bankAccount", "nonResident"],
        "properties": {
          "shopArticleId": { "type": "string", "maxLength": 32 },
          "billingDescriptor": { "type": "string", "maxLength": 14 },
          "fullName": { "type": "string" },
          "name": { "type": "string" },
          "inn": { "type": "string", "pattern": "^[0-9]{10}([0-9]{2})?$" },
          "kpp": { "type": "string", "pattern": "^[0-9]{8,9}$" },
          "ogrn": { "type": "string", "pattern": "^[0-9]{13}([0-9]{2})?$" },
          "addresses": { "type": "array", "minItems": 1 },
          "ceo": { "type": "object", "required": ["phone", "citizenship"] },
          "founders": { "type": "object", "required": ["individuals"] },
          "email": { "type": "string", "format": "email" },
          "siteUrl": { "type": "string", "format": "uri" },
          "bankAccount": { "type": "object", "required": ["account", "korAccount", "bankName", "bik", "details"] },
          "mcc": { "type": "string", "pattern": "^[0-9]{4}$" },
          "nonResident": { "type": "boolean" }
        }
      }
    }
  },
  "paths": {
    "/v2/Init": {
      "post": {
        "summary": "Инициализация платёжной сессии (O/T, DealId/CreateDealWithType, Recurrent=Y, DATA, RedirectDueDate)",
        "parameters": [
          { "$ref": "#/components/parameters/XMockScenario" },
          { "$ref": "#/components/parameters/XMockSandbox" },
          { "$ref": "#/components/parameters/XMockLatency" }
        ],
        "responses": { "200": { "description": "Сессия создана (статус NEW)" } }
      }
    },
    "/v2/GetState": {
      "post": {
        "summary": "Получение статуса платежа по PaymentId",
        "responses": { "200": { "description": "Текущий статус платежа" } }
      }
    },
    "/v2/Confirm": {
      "post": {
        "summary": "Подтверждение двухстадийного холда (AUTHORIZED -> CONFIRMED)",
        "responses": { "200": { "description": "Холд подтверждён" } }
      }
    },
    "/v2/Cancel": {
      "post": {
        "summary": "Отмена или полный/частичный возврат платежа (с проверкой незакрытости сделки)",
        "responses": { "200": { "description": "Возврат/отмена выполнены" } }
      }
    },
    "/v2/CheckOrder": {
      "post": {
        "summary": "Проверка статуса заказа по OrderId (массив Payments)",
        "responses": { "200": { "description": "Список платежей по заказу" } }
      }
    },
    "/v2/Chargeback": {
      "post": {
        "summary": "Управление жизненным циклом спора/чарджбэка (DISPUTED -> REPRESENTMENT -> ARBITRATION -> WON|LOST)",
        "responses": { "200": { "description": "Текущее состояние спора" } }
      }
    },
    "/v2/Dispute": {
      "post": {
        "summary": "Алиас /v2/Chargeback для управления спором по платежу",
        "responses": { "200": { "description": "Текущее состояние спора" } }
      }
    },
    "/v2/createSpDeal": {
      "post": {
        "summary": "Явное создание сделки Мультирасчётов N:N (возвращает SpAccumulationId)",
        "responses": { "200": { "description": "Сделка открыта" } }
      }
    },
    "/v2/closeSpDeal": {
      "post": {
        "summary": "Явное закрытие сделки Мультирасчётов (SpAccumulationId)",
        "responses": { "200": { "description": "Сделка закрыта" } }
      }
    },
    "/v2/GetQr": {
      "post": {
        "summary": "Генерация QR-кода СБП (PAYLOAD или SVG IMAGE, минимум 1000 коп. = 10 ₽)",
        "responses": { "200": { "description": "QR-код СБП сформирован" } }
      }
    },
    "/v2/Charge": {
      "post": {
        "summary": "Автосписание по сохранённой карте (RebillId)",
        "responses": { "200": { "description": "Платёж списан" } }
      }
    },
    "/v2/SendClosingReceipt": {
      "post": {
        "summary": "Отправка закрывающего чека (полный расчёт после предоплаты, ФФД 1.2)",
        "responses": { "200": { "description": "Закрывающий чек принят" } }
      }
    },
    "/v2/AddCustomer": {
      "post": {
        "summary": "Регистрация покупателя (CustomerKey) для привязки карт и рекуррентов",
        "responses": { "200": { "description": "Покупатель зарегистрирован" } }
      }
    },
    "/v2/GetCustomer": {
      "post": {
        "summary": "Получение данных покупателя по CustomerKey",
        "responses": { "200": { "description": "Данные покупателя" } }
      }
    },
    "/v2/RemoveCustomer": {
      "post": {
        "summary": "Удаление покупателя и его привязанных карт",
        "responses": { "200": { "description": "Покупатель удалён" } }
      }
    },
    "/v2/AddCard": {
      "post": {
        "summary": "Привязка карты к покупателю (CustomerKey -> CardId + RebillId)",
        "responses": { "200": { "description": "Карта привязана" } }
      }
    },
    "/v2/GetCardList": {
      "post": {
        "summary": "Список сохранённых карт покупателя (CustomerKey)",
        "responses": { "200": { "description": "Массив карт покупателя" } }
      }
    },
    "/v2/RemoveCard": {
      "post": {
        "summary": "Удаление привязанной карты по CardId",
        "responses": { "200": { "description": "Карта удалена (Status=D)" } }
      }
    },
    "/e2c/v2/Init": {
      "post": {
        "summary": "Инициализация выплаты партнёру по сделке (с проверкой остатка DealId и флагом FinalPayout)",
        "responses": { "200": { "description": "Выплата создана (Status=NEW)" } }
      }
    },
    "/e2c/v2/Payment": {
      "post": {
        "summary": "Проведение выплаты партнёру (поддержка тестовой карты 5000000000000553 -> 1057 и автозакрытия сделки по FinalPayout)",
        "responses": { "200": { "description": "Статус выплаты CONFIRMED или REJECTED" } }
      }
    },
    "/e2c/v2/GetState": {
      "post": {
        "summary": "Получение статуса выплаты e2c",
        "responses": { "200": { "description": "Текущий статус выплаты" } }
      }
    },
    "/e2c/v2/CancelPayment": {
      "post": {
        "summary": "Отмена успешной (CONFIRMED) выплаты партнёру (PartnerId) в открытой сделке; запрос обязан содержать DealId, совпадающий со сделкой выплаты. Статусы CREDIT_CANCELING → CREDIT_CANCELED; при отказе выплата остаётся в исходном статусе",
        "responses": { "200": { "description": "Выплата отменена (Status=CREDIT_CANCELED). Ошибка 7 — нет DealId/не совпадает, 32 — статус не CONFIRMED, канал не партнёрский или сделка закрыта, 8 — сделка не найдена" } }
      }
    },
    "/e2c/v2/GetSbpMembers": {
      "post": {
        "summary": "Справочник банков-участников СБП для выплат по номеру телефона",
        "responses": { "200": { "description": "Список банков СБП" } }
      }
    },
    "/oauth/token": {
      "post": {
        "security": [{ "acqapiBasic": [] }],
        "summary": "Получение OAuth 2.0 Bearer-токена для API регистрации партнёров acqapi",
        "requestBody": {
          "content": {
            "application/x-www-form-urlencoded": {
              "schema": { "type": "object", "properties": { "grant_type": { "type": "string", "enum": ["password", "client_credentials"] }, "username": { "type": "string" }, "password": { "type": "string" } } }
            }
          }
        },
        "responses": { "200": { "description": "Opaque Bearer access_token со scope partner и expires_in" }, "400": { "description": "Неподдерживаемый grant_type" }, "401": { "description": "Неверный Basic client" } }
      }
    },
    "/sm-register/register": {
      "post": {
        "security": [{ "acqapiBearer": [] }],
        "summary": "Регистрация партнёра: полная схема реквизитов ЮЛ, addresses[], ceo, founders и bankAccount",
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/AcqapiRegistration" } } } },
        "responses": { "200": { "description": "Зарегистрированный партнёр: shopArticleId маппится в shopCode" }, "400": { "description": "Схема регистрации невалидна" }, "401": { "description": "Нет/истёк/неверен Bearer" } }
      }
    },
    "/sm-register/register/shop/{shopCode}": {
      "get": {
        "security": [{ "acqapiBearer": [] }],
        "summary": "Получение зарегистрированной точки",
        "parameters": [{ "name": "shopCode", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Карточка точки" }, "401": { "description": "Нет/истёк/неверен Bearer" }, "404": { "description": "Точка не найдена" } }
      }
    },
    "/sm-register/register/{shopCode}": {
      "patch": {
        "security": [{ "acqapiBearer": [] }],
        "summary": "Обновление точки; при передаче bankAccount обязательны реквизиты счёта",
        "parameters": [{ "name": "shopCode", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Точка обновлена" }, "400": { "description": "Невалидные поля обновления" }, "401": { "description": "Нет/истёк/неверен Bearer" }, "404": { "description": "Точка не найдена" } }
      },
      "post": {
        "security": [{ "acqapiBearer": [] }],
        "summary": "Совместимый alias PATCH для обновления точки",
        "parameters": [{ "name": "shopCode", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Точка обновлена" }, "401": { "description": "Нет/истёк/неверен Bearer" } }
      }
    },
    "/av/v1/payment": {
      "post": {
        "summary": "Сигнал о поступлении верификационного платежа МСП на спецсчёт",
        "responses": { "200": { "description": "Поступление зарегистрировано" } }
      }
    },
    "/av/v1/verification": {
      "post": {
        "summary": "Верификация реквизитов («прогон рубля»)",
        "responses": { "200": { "description": "Статус RETURNED" } }
      }
    },
    "/mock/time": {
      "get": {
      "security": [{ "operatorToken": [] }], "summary": "Чтение виртуальных часов стенда", "responses": { "200": { "description": "Снимок часов" } } },
      "post": {
      "security": [{ "operatorToken": [] }], "summary": "Сдвиг или установка виртуального времени ({advance:'7d'} / {reset:true})", "responses": { "200": { "description": "Обновлённый снимок часов" } } }
    },
    "/mock/scenarios": {
      "get": {
      "security": [{ "operatorToken": [] }], "summary": "Список активных сценарных правил и история срабатываний", "responses": { "200": { "description": "Правила и история" } } },
      "post": {
      "security": [{ "operatorToken": [] }], "summary": "Добавление одноразового или постоянного правила сценария", "responses": { "200": { "description": "Правило добавлено" } } },
      "delete": {
      "security": [{ "operatorToken": [] }], "summary": "Очистка правил и истории сценариев", "responses": { "200": { "description": "Очищено" } } }
    },
    "/sandboxes": {
      "post": {
      "summary": "Создать изолированную песочницу (hosted tenancy, RFC-001): id, creds и ownerToken", "responses": { "201": { "description": "Песочница создана; ownerToken показывается один раз" }, "409": { "description": "Песочница с таким id уже существует" }, "429": { "description": "Превышен лимит количества/скорости создания" } } },
      "get": {
      "security": [{ "operatorToken": [] }, { "sandboxToken": [] }], "summary": "Список песочниц: оператору — все, владельцу (owner-token) — только своя", "responses": { "200": { "description": "Список песочниц" }, "401": { "description": "Нет owner-token или операторского токена" } } },
      "delete": {
      "security": [{ "operatorToken": [] }, { "sandboxToken": [] }], "summary": "Удалить песочницу (?sandbox=<id>): владелец или оператор", "responses": { "200": { "description": "Песочница удалена вместе с состоянием" }, "401": { "description": "Чужая песочница: знание id не является доступом" } } }
    },
    "/sandboxes/me": {
      "get": {
      "security": [{ "sandboxToken": [] }], "summary": "Своя песочница по owner-token: состояние, креды, TTL", "responses": { "200": { "description": "Описание песочницы и её креды" }, "401": { "description": "owner-token не предъявлен или неверен" } } },
      "delete": {
      "security": [{ "sandboxToken": [] }], "summary": "Удалить свою песочницу", "responses": { "200": { "description": "Песочница удалена" } } }
    },
    "/sandboxes/me/reset": {
      "post": {
      "security": [{ "sandboxToken": [] }], "summary": "Сбросить состояние своей песочницы к начальному", "responses": { "200": { "description": "Состояние сброшено" } } }
    },
    "/sandboxes/me/reset-creds": {
      "post": {
      "security": [{ "sandboxToken": [] }], "summary": "Сменить креды песочницы (owner-token сохраняется)", "responses": { "200": { "description": "Новые креды песочницы" } } }
    },
    "/mock/sandboxes": {
      "get": {
      "security": [{ "operatorToken": [] }], "summary": "Список изолированных песочниц", "responses": { "200": { "description": "Список песочниц" } } },
      "post": {
      "security": [{ "operatorToken": [] }], "summary": "Переключение или создание песочницы", "responses": { "200": { "description": "Активная песочница" } } },
      "delete": {
      "security": [{ "operatorToken": [] }], "summary": "Сброс песочницы", "responses": { "200": { "description": "Песочница сброшена" } } }
    },
    "/mock/reset": {
      "post": {
      "security": [{ "operatorToken": [] }], "summary": "Полный сброс состояния текущей песочницы, сценариев и журнала", "responses": { "200": { "description": "Сброшено" } } }
    },
    "/mock/state": {
      "get": {
      "security": [{ "operatorToken": [] }], "summary": "Экспорт полного снимка состояния песочницы", "responses": { "200": { "description": "JSON-снимок состояния" } } },
      "post": {
      "security": [{ "operatorToken": [] }], "summary": "Импорт снимка состояния песочницы", "responses": { "200": { "description": "Состояние загружено" } } }
    },
    "/mock/verify-merchant": {
      "post": {
      "security": [{ "operatorToken": [] }], "summary": "Активный экзаменатор webhook-приёмника мерчанта (3 пробы: валидная подпись, идемпотентность дубля, отказ на поддельном Token)", "responses": { "200": { "description": "Отчёт сертификации обработчика вебхуков" } } }
    },
    "/openapi.json": {
      "get": { "summary": "Спецификация OpenAPI 3.1.0 сервиса tbank-mock", "responses": { "200": { "description": "OpenAPI JSON" } } }
    }
  }
}
