    "/openapi/smb/efcp/e-commerce/v1/orders/{orderId}/cancel": {
      "post": {
        "tags": [
          "SMB E-commerce"
        ],
        "summary": "Отменить ордер",
        "description": "Допускается опциональный cancelReason. Отменяется неоплаченный ордер (CREATED) либо preauth-ордер до complete (холд снимается; статуса reversal в словаре операций нет — [VERIFY], платёж помечается voided).",
        "parameters": [
          {
            "$ref": "#/components/parameters/OrderId"
          },
          {
            "$ref": "#/components/parameters/XMockSandbox"
          },
          {
            "$ref": "#/components/parameters/XMockScenario"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
