  "components": {
    "parameters": {
      "XMockSandbox": {
        "name": "X-Mock-Sandbox",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Изоляция песочницы (RFC-001)."
      },
      "XMockScenario": {
        "name": "X-Mock-Scenario",
        "in": "header",
        "required": false,
        "schema": {
          "type": "string"
        },
        "description": "Сценарий запроса: fail, hang, latency, http-500, http-504, webhook-drop, webhook-duplicate, status-lowercase, reconciled."
      },
      "OrderId": {
        "name": "orderId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "Merchant orderId (уникальный; повтор в POST /orders идемпотентен)."
      }
    },
    "schemas": {
      "Amount": {
        "type": "object",
        "required": [
          "value",
          "code"
        ],
        "properties": {
          "value": {
            "type": "number",
            "exclusiveMinimum": 0,
            "description": "ДЕСЯТИЧНЫЕ рубли (10.56), максимум 2 знака после точки; не копейки."
          },
          "code": {
            "type": "string",
            "enum": [
              "RUB"
            ]
          }
        },
        "description": "Сумма в десятичных рублях (amountUnits среза: value, не минимальные единицы)."
      },
      "TokenResponse": {
        "type": "object",
        "required": [
          "access_token",
          "token_type",
          "expires_in"
        ],
        "properties": {
          "access_token": {
            "type": "string"
          },
          "token_type": {
            "type": "string",
            "enum": [
              "Bearer"
            ]
          },
          "expires_in": {
            "type": "integer",
            "description": "≈170 с по срезу; клиент планирует обновление по этому значению."
          }
        }
      },
      "OrderStatusValue": {
        "type": "string",
        "enum": [
          "CREATED",
          "PAID",
          "REFUNDED",
          "PARTIALLY_REFUNDED",
          "CANCELED"
        ],
        "description": "Статус ОРДЕРА (status.value на уровне ордера): CREATED — ордер создан, не оплачен; PAID — ордер оплачен; REFUNDED — по ордеру проведён полный возврат; PARTIALLY_REFUNDED — по ордеру проведён частичный возврат; CANCELED — ордер отменён (в т.ч. по истечении 20-минутного TTL)."
      },
      "OperationStatusValue": {
        "type": "string",
        "enum": [
          "NEW",
          "CONFIRMED",
          "RECONCILED"
        ],
        "description": "Статус ОПЕРАЦИИ (платёж/возврат, status.value на своём уровне): NEW — операция создана (для preauth — сумма удержана); CONFIRMED — операция подтверждена; RECONCILED — операция сверена. Не смешивать со статусом ордера."
      },
      "PaymentTransaction": {
        "type": "object",
        "required": [
          "paymentId",
          "amount",
          "status"
        ],
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "paymentCode": {
            "type": "string",
            "description": "[VERIFY]: смысл paymentCode в публичном срезе не зафиксирован; мок генерирует короткий код."
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/OperationStatusValue"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paymentData": {
            "type": "object",
            "description": "[VERIFY]: форма paymentData не зафиксирована; мок отдаёт маску карты.",
            "properties": {
              "cardMask": {
                "type": "string"
              }
            }
          },
          "voided": {
            "type": "boolean",
            "description": "[FORK]: холд снят отменой ордера (словарь операций не содержит reversal)."
          }
        }
      },
      "RefundTransaction": {
        "type": "object",
        "required": [
          "refundId",
          "paymentId",
          "amount",
          "status"
        ],
        "properties": {
          "refundId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/OperationStatusValue"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "OrderView": {
        "type": "object",
        "required": [
          "orderId",
          "orderName",
          "amount",
          "status",
          "expire",
          "payments",
          "refunds"
        ],
        "properties": {
          "orderId": {
            "type": "string"
          },
          "orderName": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/OrderStatusValue"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "expire": {
            "type": "string",
            "format": "date-time",
            "description": "ISO с миллисекундами и timezone; дефолт — 20 минут от создания."
          },
          "payUrl": {
            "type": "string",
            "format": "uri"
          },
          "twoStageParams": {
            "type": "object",
            "additionalProperties": true
          },
          "returnUrl": {
            "type": "string",
            "description": "[FORK]: mock-расширение; в SMB-срезе поля returnUrl нет."
          },
          "cancelReason": {
            "type": "string"
          },
          "payments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PaymentTransaction"
            }
          },
          "refunds": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RefundTransaction"
            }
          }
        }
      },
      "RefundView": {
        "type": "object",
        "required": [
          "refundId",
          "paymentId",
          "amount",
          "status"
        ],
        "properties": {
          "refundId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/OperationStatusValue"
              }
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PaymentCallbackObject": {
        "type": "object",
        "required": [
          "paymentId",
          "orderId",
          "amount",
          "Status"
        ],
        "properties": {
          "paymentId": {
            "type": "string"
          },
          "paymentCode": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "orderCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "paymentData": {
            "type": "object",
            "additionalProperties": true
          },
          "Status": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/OperationStatusValue"
              }
            },
            "description": "Карточный пример среза пишет Status (заглавная). Нормализация регистра ключа запрещена; СБП-пример (out of scope) использует status."
          }
        },
        "additionalProperties": true,
        "description": "object PAYMENT-callback: поля карточного примера среза (paymentId, paymentCode, orderId, orderCode, createdAt, description, amount, paymentData, Status)."
      },
      "RefundCallbackObject": {
        "type": "object",
        "required": [
          "refundId",
          "paymentId",
          "orderId",
          "amount",
          "status"
        ],
        "properties": {
          "refundId": {
            "type": "string"
          },
          "paymentId": {
            "type": "string"
          },
          "paymentCode": {
            "type": "string"
          },
          "orderId": {
            "type": "string"
          },
          "orderCode": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "amount": {
            "$ref": "#/components/schemas/Amount"
          },
          "status": {
            "type": "object",
            "required": [
              "value"
            ],
            "properties": {
              "value": {
                "$ref": "#/components/schemas/OperationStatusValue"
              }
            },
            "description": "Пример возврата в срезе использует status (строчные) — сохраняется как есть."
          }
        },
        "additionalProperties": true,
        "description": "object REFUND-callback: refundId, paymentId, paymentCode, orderId, orderCode, createdAt, amount, status."
      },
      "CallbackEnvelope": {
        "type": "object",
        "required": [
          "type",
          "object"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "PAYMENT",
              "REFUND"
            ]
          },
          "object": {
            "description": "PAYMENT — PaymentCallbackObject (Status); REFUND — RefundCallbackObject (status)."
          }
        },
        "description": "SMB callback envelope: POST JSON без подписи/ACK-кода в публичном срезе."
      },
      "ProviderError": {
        "type": "object",
        "required": [
          "error",
          "error_description"
        ],
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "invalid_request",
              "invalid_token",
              "invalid_client",
              "invalid_amount",
              "invalid_order_state",
              "order_not_found",
              "payment_not_found",
              "refund_not_found",
              "duplicate_refund_id",
              "amount_exceeds_limit",
              "preauth_disabled",
              "limit_exceeded",
              "unsupported_grant_type",
              "unsupported_method",
              "not_found",
              "system_error"
            ]
          },
          "error_description": {
            "type": "string"
          },
          "field": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          },
          "doc": {
            "type": "string"
          }
        },
        "description": "[FORK] mock envelope: публичный SMB-срез фиксирует HTTP-статусы, но не полную схему тела бизнес-ошибок; OAuth-ошибки token endpoint следуют RFC 6749 §5.2. field/hint/doc — DX-расширение мока."
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "ok",
          "api",
          "base"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          },
          "api": {
            "type": "string",
            "enum": [
              "smb-ecommerce-json"
            ]
          },
          "base": {
            "type": "string"
          },
          "tokenTtlSecs": {
            "type": "integer"
          },
          "orderTtlSecs": {
            "type": "integer"
          },
          "preauth": {
            "type": "boolean"
          },
          "callbackSignature": {
            "type": "string",
            "enum": [
              "none"
            ]
          }
        }
      },
      "TimeRequest": {
        "type": "object",
        "properties": {
          "advance": {
            "type": "string",
            "description": "Например \"+20m\" (истечение ордера) или \"+60s\" (retry callback)."
          },
          "offset": {
            "type": "integer"
          },
          "iso": {
            "type": "string"
          },
          "reset": {
            "type": "boolean"
          }
        }
      },
      "ScenarioRequest": {
        "type": "object",
        "required": [
          "scenario"
        ],
        "properties": {
          "scenario": {
            "type": "string"
          },
          "target": {
            "type": "string"
          },
          "match": {
            "type": "object"
          },
          "times": {
            "type": "integer"
          },
          "persistent": {
            "type": "boolean"
          }
        }
      },
      "AdminActionRequest": {
        "type": "object",
        "required": [
          "action",
          "id"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "expire-order",
              "duplicate-callback"
            ]
          },
          "id": {
            "type": "string"
          },
          "_csrf": {
            "type": "string"
          }
        }
      }
    },
    "requestBodies": {
      "CreateOrderBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "orderId",
                "orderName",
                "amount"
              ],
              "properties": {
                "orderId": {
                  "type": "string",
                  "maxLength": 128
                },
                "orderName": {
                  "type": "string",
                  "maxLength": 256
                },
                "amount": {
                  "$ref": "#/components/schemas/Amount"
                },
                "description": {
                  "type": "string"
                },
                "expire": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Опционально: ISO с timezone и миллисекундами."
                },
                "returnUrl": {
                  "type": "string",
                  "description": "[FORK] mock-расширение."
                }
              }
            }
          }
        }
      },
      "CreatePreauthBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "orderId",
                "orderName",
                "amount",
                "twoStageParams"
              ],
              "properties": {
                "orderId": {
                  "type": "string"
                },
                "orderName": {
                  "type": "string"
                },
                "amount": {
                  "$ref": "#/components/schemas/Amount"
                },
                "twoStageParams": {
                  "type": "object",
                  "additionalProperties": true,
                  "description": "[VERIFY]: форма объекта в публичном срезе не зафиксирована."
                },
                "expire": {
                  "type": "string",
                  "format": "date-time"
                },
                "returnUrl": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "AmountBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "amount"
              ],
              "properties": {
                "amount": {
                  "$ref": "#/components/schemas/Amount"
                }
              }
            }
          }
        }
      },
      "CreateRefundBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "required": [
                "refundId",
                "paymentId",
                "amount"
              ],
              "properties": {
                "refundId": {
                  "type": "string",
                  "maxLength": 128
                },
                "paymentId": {
                  "type": "string"
                },
                "amount": {
                  "$ref": "#/components/schemas/Amount"
                }
              }
            }
          }
        }
      },
      "TimeRequestBody": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/TimeRequest"
            }
          }
        }
      },
      "ScenarioRequestBody": {
        "required": true,
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ScenarioRequest"
            }
          }
        }
      },
      "StateEnvelopeBody": {
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      },
      "AdminActionBody": {
        "required": true,
        "content": {
          "application/x-www-form-urlencoded": {
            "schema": {
              "$ref": "#/components/schemas/AdminActionRequest"
            }
          }
        }
      }
    },
    "responses": {
      "RestResponse": {
        "description": "Успех: OrderView или RefundView (status.value на своём уровне)."
      },
      "TransportError": {
        "description": "Provider-shaped ошибка {error, error_description, field, hint, doc}.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ProviderError"
            }
          }
        }
      },
      "HtmlPage": {
        "description": "HTML-страница тестовой оплаты/консоли.",
        "content": {
          "text/html": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "JsonControl": {
        "description": "JSON control-plane ответ.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "additionalProperties": true
            }
          }
        }
      }
    }
  }
}
