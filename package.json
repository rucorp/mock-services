{
  "name": "mock-services",
  "version": "0.5.0",
  "private": true,
  "description": "Mock bank & fiscal (OFD) services for testing payment integrations against official provider protocols",
  "scripts": {
    "test": "npm run test:core && npm run test:tbank && npm run test:kassa && npm run test:yookassa && npm run test:atol && npm run test:upstream && npm run check:links && npm run check:drift",
    "test:core": "node packages/core/selftest.js",
    "test:upstream": "node scripts/sync-upstream-selftest.js",
    "test:docker": "node scripts/docker-smoke.js",
    "check:upstream": "node scripts/sync-upstream.js",
    "check:links": "node scripts/check-docs-links.js",
    "test:tbank": "node services/tbank-mock/selftest.js",
    "test:kassa": "node services/kassa-mock/selftest.js",
    "test:yookassa": "node services/yookassa-mock/selftest.js",
    "test:atol": "node services/atol-mock/selftest.js",
    "test:compose": "node scripts/compose-selftest.js",
    "check:drift": "node scripts/check-protocol-drift.js",
    "start:tbank": "node services/tbank-mock/server.js",
    "start:kassa": "node services/kassa-mock/server.js",
    "start:yookassa": "node services/yookassa-mock/server.js",
    "start:atol": "node services/atol-mock/server.js",
    "smoke": "node -e \"const h=require('http');for(const [name,url] of [['tbank','http://127.0.0.1:3100/health'],['kassa','http://127.0.0.1:3101/healthz'],['yookassa','http://127.0.0.1:3102/health'],['atol','http://127.0.0.1:3103/health']]){h.get(url,(r)=>console.log(name,r.statusCode)).on('error',(e)=>console.log(name,'нет ответа:',e.message))}\""
  },
  "engines": {
    "node": ">=18"
  },
  "license": "Apache-2.0",
  "keywords": [
    "mock",
    "acquiring",
    "ofd",
    "fiscal",
    "54-fz",
    "tbank",
    "ferma",
    "atol",
    "payments",
    "testing",
    "sandbox"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rucorp/mock-services.git"
  },
  "bugs": {
    "url": "https://github.com/rucorp/mock-services/issues"
  },
  "homepage": "https://github.com/rucorp/mock-services#readme",
  "files": [
    "packages",
    "services",
    "scripts",
    "protocols",
    "docker-compose.include.yml",
    "docs/integration",
    "docs/openapi",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
